# Configuracion del backend de mercado (NestJS).
# Copia este archivo a `.env` y completa con TUS credenciales. NUNCA subas `.env` al repositorio.
# Ejecutar con:  npm run build  &&  node --env-file=.env dist/main.js

# Endpoint base de la API oficial de Mercado Libre (no cambiar salvo migracion).
MERCADO_API_BASE=https://api.mercadolibre.com
# Sitio/pais. Argentina = MLA.
MERCADO_SITE_ID=MLA

# Credenciales de la aplicacion creada en https://developers.mercadolibre.com.ar
# Dejar vacio hasta tenerlas: sin ellas la API responde estado "no_configurado" (no inventa datos).
MERCADO_CLIENT_ID=
MERCADO_CLIENT_SECRET=
# Refresh token obtenido al autorizar la app (OAuth). Es un secreto: solo aqui.
MERCADO_REFRESH_TOKEN=

# Ruta donde se persiste el refresh token rotativo (permisos 600). Relativa al cwd del backend.
MERCADO_TOKEN_STORE=.mercado-token.json

# Limites y tiempos de espera.
MERCADO_MAX_RESULTADOS=50
MERCADO_TIMEOUT_MS=8000
MERCADO_REQ_POR_MINUTO=60

# CORS (URL del frontend Angular en desarrollo).
MERCADO_CORS_ORIGIN=http://localhost:4200

# Puerto del backend.
PORT=3000

# ---------------------------------------------------------------------------
# OAuth local (paso manual unico para obtener el refresh_token)
# ---------------------------------------------------------------------------
# Base del consentimiento OAuth. Argentina = auth.mercadolibre.com.ar
MERCADO_AUTH_BASE=https://auth.mercadolibre.com.ar

# URI de redireccion EXACTA registrada en la aplicacion.
# IMPORTANTE: Mercado Libre exige HTTPS en el redirect_uri, incluso para local.
# Ejemplo valido: https://localhost/callback  (no hace falta que el servidor exista:
# copia el "code" desde la barra de direcciones del navegador).
MERCADO_OAUTH_REDIRECT_URI=

# Activar solo si la aplicacion tiene PKCE habilitado en Mercado Libre Developers.
MERCADO_OAUTH_PKCE=false

# Archivo temporal donde se guarda state/code_verifier entre "iniciar" y "canjear".
MERCADO_OAUTH_STATE_STORE=.mercado-oauth-state.json

# ---------------------------------------------------------------------------
# Capa de IA (resumen de precios ya traidos de una fuente real)
# ---------------------------------------------------------------------------
# La IA NO trae precios por si sola ni los inventa: solo resume publicaciones reales.
# Valores: "ninguno" (default, IA desactivada) o "gemini".
IA_PROVEEDOR=ninguno

# API key de Google AI Studio (https://aistudio.google.com/apikey). Es un secreto: solo aqui.
# Dejar vacia hasta tenerla; con IA_PROVEEDOR=gemini y sin key, la IA queda desactivada.
GEMINI_API_KEY=

# Modelo de Gemini. Los modelos vigentes son de la familia 3.x (ej. gemini-3.5-flash).
# OJO: gemini-2.5-flash ya no admite generateContent (HTTP 404).
GEMINI_MODELO=gemini-3.5-flash

# Activa "Grounding with Google Search": el resumen se apoya en busquedas reales con fuentes.
# ADVERTENCIA: en el tier GRATUITO la cuota de busqueda web es minima y devuelve 429 (limite).
# Para busqueda real, activar facturacion o usar otro proveedor. El resumen sin grounding si es gratis.
GEMINI_BUSQUEDA_WEB=true

# Endpoint base de la API de Gemini (no cambiar salvo migracion).
GEMINI_API_BASE=https://generativelanguage.googleapis.com

# Tiempo maximo de espera del proveedor de IA (ms). Gemini puede tardar mas que una busqueda simple.
IA_TIMEOUT_MS=60000
# Reintentos ante 503/5xx del proveedor (responde de forma intermitente).
IA_REINTENTOS=3
